{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Sver0411/OpportunityRadar/schemas/profile.schema.json",
  "title": "OpportunityRadar User Profile",
  "description": "用户画像。渐进式构建：只写用户明确说过的内容，缺失一律 null，不要猜测。",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "profile_version": { "type": ["integer", "string", "null"], "default": 1 },
    "updated_at": { "type": ["string", "null"], "description": "ISO 8601 时间戳" },

    "education": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "description": "教育背景。全部字段可为空；不要因为缺失就填默认值。",
      "properties": {
        "school": { "type": ["string", "null"] },
        "school_country": { "type": ["string", "null"] },
        "school_city": { "type": ["string", "null"] },
        "school_level": {
          "type": ["string", "null"],
          "description": "如 985 / 211 / 双一流 / national / private / unknown"
        },
        "degree": {
          "anyOf": [
            { "$ref": "#/$defs/educationLevel" },
            { "type": "array", "items": { "$ref": "#/$defs/educationLevel" } },
            { "type": "null" }
          ]
        },
        "major": { "type": ["string", "null"], "description": "专业原名" },
        "major_family": {
          "type": ["string", "null"],
          "description": "归一化专业族，用于搜索矩阵映射。如 iot_embedded / cs_software / ai_data / ee / me_aero / design / business / lifesci",
          "examples": ["iot_embedded", "cs_software", "ai_data", "ee", "me_aero", "design", "business", "lifesci"]
        },
        "enrollment_year": { "type": ["integer", "null"] },
        "current_year": { "type": ["integer", "null"], "description": "当前学年，如 1-4（本科）、1-3（硕士）" },
        "expected_graduation": {
          "type": ["string", "null"],
          "description": "毕业时间，如 2027-03 / 2027 年 3 月。中国应届生身份与日本卒業年度判断依赖此字段"
        },
        "GPA": { "type": ["string", "number", "null"], "description": "保留原始表达，如 \"3.6/4.0\" 或 \"85/100\"，不要换算" },
        "ranking": { "type": ["string", "null"], "description": "如 \"前 10%\" / \"第 5/120\"" }
      }
    },

    "skills": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string" },
          "level": {
            "type": ["string", "null"],
            "enum": ["beginner", "intermediate", "advanced", "expert", "unknown", null]
          },
          "evidence": { "type": ["string", "null"], "description": "证据：项目/证书/仓库链接" }
        },
        "required": ["name"]
      }
    },

    "nationality": {
      "type": ["string", "null"],
      "description": "国籍（用于判断 nationality_requirement）。未提供 → null；不要由学校所在地推断国籍"
    },

    "languages": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "language": { "type": "string" },
          "exam": { "type": ["string", "null"], "description": "JLPT / TOEIC / IELTS / TOEFL / CET / TOPIK / null" },
          "score": { "type": ["string", "number", "null"] },
          "level": {
            "type": ["string", "null"],
            "description": "如 N2 / B2 / 日常会話。约定：填 none/no/不会/无 表示用户**明确不具备**该语言（只有这种显式标记才允许把资格判为不满足）；留 null 表示未知"
          }
        },
        "required": ["language"]
      }
    },

    "experience": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "projects": { "type": ["array", "null"], "items": { "type": ["string", "object"] } },
        "github": { "type": ["string", "null"] },
        "research": { "type": ["array", "null"], "items": { "type": ["string", "object"] } },
        "internships": { "type": ["array", "null"], "items": { "type": ["string", "object"] } },
        "competitions": { "type": ["array", "null"], "items": { "type": ["string", "object"] } },
        "open_source": { "type": ["array", "null"], "items": { "type": ["string", "object"] } },
        "certificates": { "type": ["array", "null"], "items": { "type": ["string", "object"] } },
        "portfolio": { "type": ["array", "null"], "items": { "type": ["string", "object"] } }
      }
    },

    "interests": {
      "type": ["array", "null"],
      "description": "兴趣方向。必须真正参与搜索，不是装饰字段。",
      "items": { "type": "string" },
      "examples": [["AI", "Agent", "IoT", "Embedded", "Robotics", "Drone", "Photography", "Automotive", "Aviation", "Game Development", "Design", "Maker"]]
    },

    "goals": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "type": {
            "type": "string",
            "description": "目标类型，与 opportunity taxonomy 的类别对齐",
            "enum": ["internship", "fulltime", "research", "competition", "education", "language", "skill", "open_source", "hobby", "funding", "event", "project", "entrepreneurship", "networking"]
          },
          "priority": { "type": ["string", "null"], "enum": ["high", "medium", "low", null] },
          "note": { "type": ["string", "null"] }
        },
        "required": ["type"]
      }
    },

    "constraints": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "preferred_country": { "type": ["array", "string", "null"], "items": { "type": "string" } },
        "preferred_city": { "type": ["array", "string", "null"], "items": { "type": "string" } },
        "remote": { "type": ["boolean", "null"] },
        "relocation": { "type": ["boolean", "null"] },
        "unpaid": {
          "type": ["boolean", "string", "null"],
          "description": "是否接受无薪。true=接受，false=不接受，null=未说明"
        },
        "budget": { "type": ["string", "number", "null"] },
        "weekly_time": { "type": ["string", "number", "null"], "description": "每周可投入小时数，如 15" },
        "available_period": { "type": ["string", "null"], "description": "可投入的时间段，如 2026-12 ~ 2027-02" },
        "visa": { "type": ["string", "null"], "description": "签证/工作许可状态，如 student_visa_jp / need_sponsorship / none" },
        "language_constraint": { "type": ["array", "string", "null"], "items": { "type": "string" } }
      }
    },

    "_source": {
      "type": ["string", "null"],
      "description": "user_stated | user_confirmed | inferred_pending。inferred_pending 仅可用于搜索扩词，不得用于资格判断"
    },
    "_notes": { "type": ["array", "null"], "items": { "type": "string" } }
  },
  "$defs": {
    "educationLevel": {
      "type": "string",
      "enum": ["high_school", "undergraduate", "master", "phd", "postdoc", "any"]
    }
  }
}
