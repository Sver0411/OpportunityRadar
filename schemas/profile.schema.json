{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Sver0411/OpportunityRadar/schemas/profile.schema.json",
  "title": "OpportunityRadar User Profile",
  "description": "用户画像。渐进式构建：只写用户明确说过的内容，缺失一律 null，不要猜测。",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "profile_version": {
      "type": [
        "integer",
        "string",
        "null"
      ],
      "default": 1
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "ISO 8601 时间戳"
    },
    "education": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "教育背景。全部字段可为空；不要因为缺失就填默认值。",
      "properties": {
        "school": {
          "type": [
            "string",
            "null"
          ]
        },
        "school_country": {
          "type": [
            "string",
            "null"
          ]
        },
        "school_city": {
          "type": [
            "string",
            "null"
          ]
        },
        "school_level": {
          "type": [
            "string",
            "null"
          ],
          "description": "如 985 / 211 / 双一流 / national / private / unknown"
        },
        "degree": {
          "anyOf": [
            {
              "$ref": "#/$defs/educationLevel"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/educationLevel"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "major": {
          "type": [
            "string",
            "null"
          ],
          "description": "专业原名"
        },
        "major_family": {
          "type": [
            "string",
            "null"
          ],
          "description": "归一化专业族，用于搜索矩阵映射。如 iot_embedded / cs_software / ai_data / ee / me_aero / design / business / lifesci",
          "examples": [
            "iot_embedded",
            "cs_software",
            "ai_data",
            "ee",
            "me_aero",
            "design",
            "business",
            "lifesci"
          ]
        },
        "enrollment_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "current_year": {
          "type": [
            "integer",
            "null"
          ],
          "description": "当前学年，如 1-4（本科）、1-3（硕士）"
        },
        "expected_graduation": {
          "type": [
            "string",
            "null"
          ],
          "description": "毕业时间，如 2027-03 / 2027 年 3 月。中国应届生身份与日本卒業年度判断依赖此字段"
        },
        "GPA": {
          "type": [
            "string",
            "number",
            "null"
          ],
          "description": "保留原始表达，如 \"3.6/4.0\" 或 \"85/100\"，不要换算"
        },
        "ranking": {
          "type": [
            "string",
            "null"
          ],
          "description": "如 \"前 10%\" / \"第 5/120\""
        }
      }
    },
    "skills": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string"
          },
          "level": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "beginner",
              "intermediate",
              "advanced",
              "expert",
              "unknown",
              null
            ]
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ],
            "description": "证据：项目/证书/仓库链接"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "nationality": {
      "type": [
        "string",
        "null"
      ],
      "description": "国籍（用于判断 nationality_requirement）。未提供 → null；不要由学校所在地推断国籍"
    },
    "languages": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "language": {
            "type": "string"
          },
          "exam": {
            "type": [
              "string",
              "null"
            ],
            "description": "JLPT / TOEIC / IELTS / TOEFL / CET / TOPIK / null"
          },
          "score": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "level": {
            "type": [
              "string",
              "null"
            ],
            "description": "如 N2 / B2 / 日常会話。约定：填 none/no/不会/无 表示用户**明确不具备**该语言（只有这种显式标记才允许把资格判为不满足）；留 null 表示未知"
          }
        },
        "required": [
          "language"
        ]
      }
    },
    "experience": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "properties": {
        "projects": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "string",
              "object"
            ]
          }
        },
        "github": {
          "type": [
            "string",
            "null"
          ]
        },
        "research": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "string",
              "object"
            ]
          }
        },
        "internships": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "string",
              "object"
            ]
          }
        },
        "competitions": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "string",
              "object"
            ]
          }
        },
        "open_source": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "string",
              "object"
            ]
          }
        },
        "certificates": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "string",
              "object"
            ]
          }
        },
        "portfolio": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "string",
              "object"
            ]
          }
        }
      }
    },
    "interests": {
      "type": [
        "array",
        "null"
      ],
      "description": "兴趣方向。必须真正参与搜索，不是装饰字段。",
      "items": {
        "type": "string"
      },
      "examples": [
        [
          "AI",
          "Agent",
          "IoT",
          "Embedded",
          "Robotics",
          "Drone",
          "Photography",
          "Automotive",
          "Aviation",
          "Game Development",
          "Design",
          "Maker"
        ]
      ]
    },
    "goals": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "type": {
            "type": "string",
            "description": "目标类型，与 opportunity taxonomy 的类别对齐",
            "enum": [
              "career",
              "internship",
              "fulltime",
              "research",
              "competition",
              "education",
              "language",
              "skill",
              "open_source",
              "hobby",
              "funding",
              "event",
              "project",
              "entrepreneurship",
              "networking"
            ]
          },
          "priority": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "high",
              "medium",
              "low",
              null
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "type"
        ]
      }
    },
    "constraints": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "properties": {
        "preferred_country": {
          "type": [
            "array",
            "string",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "preferred_city": {
          "type": [
            "array",
            "string",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "preferred_region": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "省/大区级偏好（如 浙江、江浙沪、Bavaria）。与 preferred_city 一样是显式偏好，参与地区解析（scripts/locales.py 会把地名作为 place_hints 带进搜索 query）"
        },
        "organization_size": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "micro",
                "small",
                "medium",
                "large"
              ]
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "micro",
                  "small",
                  "medium",
                  "large"
                ]
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "仅在用户明确限定企业规模时使用；本轮限定优先放在临时 context，而非持久画像"
        },
        "remote": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "relocation": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "unpaid": {
          "type": [
            "boolean",
            "string",
            "null"
          ],
          "description": "是否接受无薪。true=接受，false=不接受，null=未说明"
        },
        "budget": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "weekly_time": {
          "type": [
            "string",
            "number",
            "null"
          ],
          "description": "每周可投入小时数，如 15"
        },
        "available_period": {
          "type": [
            "string",
            "null"
          ],
          "description": "可投入的时间段，如 2026-12 ~ 2027-02"
        },
        "visa": {
          "type": [
            "string",
            "null"
          ],
          "description": "签证/工作许可状态，如 student_visa_jp / need_sponsorship / none"
        },
        "language_constraint": {
          "type": [
            "array",
            "string",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "_source": {
      "type": [
        "string",
        "null"
      ],
      "description": "整份画像的来源标记：user_stated | user_confirmed | inferred_pending。缺省视为 user_stated（向后兼容）。inferred_pending 表示内容由推断得到"
    },
    "_provenance": {
      "type": [
        "object",
        "null"
      ],
      "description": "字段级来源标记（可选，比 _source 更细）。只有被标为 inferred_pending 的**硬性资格字段**会被排除在资格判断之外，仍可用于搜索扩词与排序。",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "user_stated",
          "user_confirmed",
          "inferred_pending"
        ]
      },
      "properties": {
        "education.degree": {
          "type": "string"
        },
        "education.current_year": {
          "type": "string"
        },
        "education.expected_graduation": {
          "type": "string"
        },
        "education.GPA": {
          "type": "string"
        },
        "education.school": {
          "type": "string"
        },
        "education.major": {
          "type": "string"
        },
        "nationality": {
          "type": "string"
        },
        "languages": {
          "type": "string"
        },
        "constraints.visa": {
          "type": "string"
        }
      }
    },
    "_notes": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "life_stage": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "enum": [
          "student",
          "working",
          "studying_and_working",
          "career_break",
          "unemployed",
          "self_employed",
          "founder"
        ]
      },
      "description": "人生状态（可多标签）：真实的人不是单一状态"
    },
    "career_stage": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "enum": [
          "pre_college",
          "undergraduate",
          "graduate_student",
          "new_grad",
          "early_career",
          "mid_career",
          "senior_ic",
          "manager",
          "executive",
          "researcher",
          "founder",
          "freelancer",
          "career_switcher",
          "returning_to_work"
        ]
      },
      "description": "职业阶段（可多标签）"
    },
    "employment": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "full_time",
            "part_time",
            "contract",
            "intern",
            "self_employed",
            "freelance",
            "unemployed",
            "on_leave",
            "student_worker",
            "unknown",
            null
          ]
        },
        "industry": {
          "type": [
            "string",
            "null"
          ]
        },
        "company_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "startup",
            "sme",
            "large_enterprise",
            "public_sector",
            "nonprofit",
            "university",
            "research_institute",
            "unknown",
            null
          ]
        },
        "company_size": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "micro",
            "small",
            "medium",
            "large",
            "unknown",
            null
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "function": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "engineering",
            "research",
            "product",
            "design",
            "data",
            "sales",
            "marketing",
            "operations",
            "finance",
            "hr",
            "support",
            "other",
            "unknown",
            null
          ]
        },
        "seniority": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "intern",
            "junior",
            "mid",
            "senior",
            "staff",
            "principal",
            "lead",
            "manager",
            "director",
            "unknown",
            null
          ]
        },
        "years_of_experience": {
          "type": [
            "number",
            "null"
          ]
        },
        "management_level": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "none",
            "team_lead",
            "manager",
            "director",
            "executive",
            "unknown",
            null
          ]
        },
        "employment_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "permanent",
            "fixed_term",
            "contract",
            "temporary",
            "apprenticeship",
            "unknown",
            null
          ]
        }
      },
      "additionalProperties": true,
      "description": "职业信息（渐进式，缺失保持 null）"
    },
    "career_state": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "current_direction": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_industry": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_company_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_country": {
          "type": [
            "string",
            "null"
          ]
        },
        "promotion_target": {
          "type": [
            "string",
            "null"
          ]
        },
        "switch_intent": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "换工作/换方向意向"
        },
        "management_intent": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "管理路线意向"
        },
        "specialist_intent": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "专家路线意向"
        },
        "entrepreneurship_intent": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "创业意向"
        },
        "compensation_growth_intent": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "涨薪导向"
        },
        "work_life_balance_intent": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "工作生活平衡导向"
        },
        "timeline": {
          "type": [
            "string",
            "null"
          ]
        },
        "growth_bottlenecks": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "description": "职业状态与目标方向"
    },
    "decision_preferences": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "risk_tolerance": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "风险承受度"
        },
        "competition_tolerance": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "竞争激烈机会的接受度"
        },
        "time_horizon": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "short",
            "medium",
            "long",
            "unknown",
            null
          ]
        },
        "prefer_public_output": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "偏好公开成果"
        },
        "prefer_low_commitment": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "偏好低投入"
        },
        "prefer_high_upside": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "偏好高上限"
        },
        "prefer_structured_program": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "偏好有组织项目"
        },
        "prefer_independent_work": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "偏好独立工作"
        },
        "prefer_networking": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "偏好认识人"
        },
        "prefer_remote": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "偏好远程"
        },
        "prefer_paid": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "偏好有报酬"
        }
      },
      "additionalProperties": true,
      "description": "决策偏好：背景相同的两个人选择方式可能完全不同"
    },
    "dealbreakers": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "description": "明确不接受的条件（用户语言）；inferred 的不得冒充 user_stated"
    },
    "green_lights": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "description": "明确加分的条件（用户语言）"
    }
  },
  "$defs": {
    "educationLevel": {
      "type": "string",
      "enum": [
        "high_school",
        "undergraduate",
        "master",
        "phd",
        "postdoc",
        "any"
      ]
    }
  }
}