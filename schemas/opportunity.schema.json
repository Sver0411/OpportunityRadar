{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Sver0411/OpportunityRadar/schemas/opportunity.schema.json",
  "title": "OpportunityRadar Opportunity",
  "description": "一条机会的结构化记录。任何字段缺失一律写 null，禁止猜测或推断填充。抽取规范见 references/extraction-policy.md。",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "title",
    "organization",
    "primary_category"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "稳定 ID：小写字母/数字/CJK，用连字符连接，建议含周期年份（如 sony-embedded-2027）。同一机会同一周期必须同一 ID，否则 Seen State 失效。生成规则见 scripts/common.py derive_id()",
      "pattern": "^[0-9a-z\\u3040-\\u30ff\\u3400-\\u4dbf\\u4e00-\\u9fff\\uac00-\\ud7af][0-9a-z\\u3040-\\u30ff\\u3400-\\u4dbf\\u4e00-\\u9fff\\uac00-\\ud7af._-]*$"
    },
    "title": {
      "type": "string",
      "description": "官方名称原文，可加短注；不要自创营销化标题"
    },
    "organization": {
      "type": "string",
      "description": "主办/招聘主体"
    },
    "primary_category": {
      "$ref": "#/$defs/category"
    },
    "secondary_categories": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/category"
      },
      "description": "可多标签。默认主类选择见 references/opportunity-taxonomy.md §14"
    },
    "tags": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "description": "3–8 个自由短标签，仅使用页面能支撑的标签"
    },
    "summary": {
      "type": [
        "string",
        "null"
      ],
      "description": "≤2 句、纯事实、无营销形容词"
    },
    "country": {
      "type": [
        "string",
        "null"
      ]
    },
    "city": {
      "type": [
        "string",
        "null"
      ]
    },
    "region": {
      "type": [
        "string",
        "null"
      ],
      "description": "官方地点所在省/州/大区；由城市推导时须标注 inferred，不得冒充官方明写"
    },
    "remote": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "education_level": {
      "anyOf": [
        {
          "$ref": "#/$defs/educationLevel"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/educationLevel"
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "申请人当前学历门槛，不是教育项目授予的学位。未写明或仅写 \"students\" 时 → null"
    },
    "program_degree": {
      "anyOf": [
        {
          "$ref": "#/$defs/educationLevel"
        },
        {
          "type": "null"
        }
      ],
      "description": "教育项目完成后授予的学位，例如硕士项目为 master；不得填入 education_level"
    },
    "cohort_year": {
      "type": [
        "integer",
        "null"
      ],
      "description": "毕业届别/入学届别，不等于报名开放年份"
    },
    "organization_size": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "micro",
        "small",
        "medium",
        "large",
        "unknown",
        null
      ],
      "description": "有可靠规模证据时填写；专精特新、上市与否不能单独推出规模"
    },
    "organization_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "independent",
        "subsidiary",
        "group",
        "unknown",
        null
      ]
    },
    "student_year": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "在读学年；中国校招/日本インターン通常更依赖 graduation_window"
    },
    "graduation_window": {
      "type": [
        "string",
        "null"
      ],
      "description": "毕业时间窗口，如 \"2027-03\" / \"2028 年 3 月卒業見込\""
    },
    "major_requirement": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "保留页面原文（如 \"Electrical Engineering or related field\"），不要改写成概括词"
    },
    "skills_required": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "skills_preferred": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "language_requirement": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/languageRequirement"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/languageRequirement"
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "页面未明写时必须是 null —— 不得因国籍/地区推断语言等级要求。单个要求可直接用对象形式。"
    },
    "nationality_requirement": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "国籍/签证/工作许可限制。未写明 → null（≠ 无限制）"
    },
    "school_requirement": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "GPA_requirement": {
      "type": [
        "string",
        "number",
        "null"
      ],
      "description": "保留原表达，不换算"
    },
    "application_open": {
      "type": [
        "string",
        "null"
      ],
      "description": "报名开放日，YYYY-MM-DD 或 RFC3339；年份不明 → null"
    },
    "application_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "open",
        "closed",
        "not_open",
        "unknown",
        null
      ],
      "description": "官方页面观察到的申请状态；必须在 evidence.application_status 记录来源和核验日期"
    },
    "deadline": {
      "type": [
        "string",
        "null"
      ],
      "description": "报名截止。滚动招募 → null，并在 notes/deadline_type 说明"
    },
    "deadline_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "fixed",
        "range",
        "rolling",
        "asap",
        "flexible",
        "tbd",
        "unknown",
        null
      ],
      "description": "截止日语义（由 scripts/normalize_date.py 判定）。rolling=滚动招募、asap=尽快无日期、tbd=未公布，三者不可混为一谈；区间类紧迫度以 end（=deadline）为准"
    },
    "event_start": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_end": {
      "type": [
        "string",
        "null"
      ]
    },
    "cost": {
      "type": [
        "string",
        "number",
        "null"
      ],
      "description": "参加费/报名费；免费写 \"free\""
    },
    "compensation": {
      "type": [
        "string",
        "null"
      ],
      "description": "薪资/报酬；明确无薪要显式写 \"unpaid\"/\"無給\"/\"无薪\""
    },
    "prize": {
      "type": [
        "string",
        "null"
      ]
    },
    "funding": {
      "type": [
        "string",
        "null"
      ],
      "description": "资助/奖金池/资源额度"
    },
    "team_requirement": {
      "type": [
        "string",
        "null"
      ],
      "description": "组队要求：人数、是否可跨校/跨国"
    },
    "time_commitment": {
      "type": [
        "string",
        "null"
      ],
      "description": "时间投入，如 \"每周 20 小时\" / \"3 个月全职\""
    },
    "required_materials": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "official_url": {
      "type": [
        "string",
        "null"
      ],
      "description": "实际打开并在其中读到该事实的官方页面。找不到 → null，并写 \"未找到官方确认来源\"。禁止猜测 URL"
    },
    "discovery_url": {
      "type": [
        "string",
        "null"
      ],
      "description": "最早发现该机会的页面（可为 Tier C/D）"
    },
    "alternate_sources": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "url": {
            "type": "string"
          },
          "tier": {
            "$ref": "#/$defs/trustTier"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "description": "去重后保留的其它来源"
    },
    "trust_tier": {
      "$ref": "#/$defs/trustTier"
    },
    "verification_status": {
      "$ref": "#/$defs/verificationStatus"
    },
    "last_verified": {
      "type": [
        "string",
        "null"
      ],
      "description": "YYYY-MM-DD"
    },
    "layer": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "exploit",
        "adjacent",
        "explore",
        null
      ],
      "description": "发现层：直接 / 相邻 / 可迁移探索"
    },
    "eligibility": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "资格判定结果（由 references/eligibility.md 得出）",
      "properties": {
        "verdict": {
          "$ref": "#/$defs/eligibilityVerdict"
        },
        "reasons": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "unknowns": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "value": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "价值评估。取值 High / Medium / Low / Unknown；不要每项都写 High",
      "properties": {
        "career": {
          "$ref": "#/$defs/valueLevel"
        },
        "research": {
          "$ref": "#/$defs/valueLevel"
        },
        "skill": {
          "$ref": "#/$defs/valueLevel"
        },
        "portfolio": {
          "$ref": "#/$defs/valueLevel"
        },
        "networking": {
          "$ref": "#/$defs/valueLevel"
        },
        "financial": {
          "$ref": "#/$defs/valueLevel"
        },
        "interest": {
          "$ref": "#/$defs/valueLevel"
        }
      }
    },
    "evidence": {
      "type": [
        "object",
        "null"
      ],
      "description": "字段级证据（provenance）。关键字段用结构化证据标注，而不是全部塞进自由文本 notes。只写真正被追踪的字段。",
      "additionalProperties": {
        "$ref": "#/$defs/evidenceEntry"
      },
      "properties": {
        "application_status": {
          "$ref": "#/$defs/evidenceEntry"
        },
        "deadline": {
          "$ref": "#/$defs/evidenceEntry"
        },
        "education_level": {
          "$ref": "#/$defs/evidenceEntry"
        },
        "student_year": {
          "$ref": "#/$defs/evidenceEntry"
        },
        "graduation_window": {
          "$ref": "#/$defs/evidenceEntry"
        },
        "major_requirement": {
          "$ref": "#/$defs/evidenceEntry"
        },
        "language_requirement": {
          "$ref": "#/$defs/evidenceEntry"
        },
        "nationality_requirement": {
          "$ref": "#/$defs/evidenceEntry"
        },
        "school_requirement": {
          "$ref": "#/$defs/evidenceEntry"
        },
        "GPA_requirement": {
          "$ref": "#/$defs/evidenceEntry"
        },
        "compensation": {
          "$ref": "#/$defs/evidenceEntry"
        },
        "organization_size": {
          "$ref": "#/$defs/evidenceEntry"
        }
      }
    },
    "seen_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "new",
        "changed",
        "repeat",
        null
      ]
    },
    "notes": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "description": "冲突说明、Explicit/Inferred/Unknown 标注、滚动招募等"
    },
    "outcomes": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "career": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "career 方面的产出"
        },
        "research": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "research 方面的产出"
        },
        "portfolio": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "portfolio 方面的产出"
        },
        "admission": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "admission 方面的产出"
        },
        "credential": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "credential 方面的产出"
        },
        "network": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "network 方面的产出"
        },
        "financial": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "financial 方面的产出"
        },
        "reputation": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "reputation 方面的产出"
        },
        "exposure": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "exposure 方面的产出"
        },
        "skill": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "skill 方面的产出"
        },
        "interest": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "interest 方面的产出"
        },
        "management": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "management 方面的产出"
        },
        "entrepreneurship": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "entrepreneurship 方面的产出"
        }
      },
      "additionalProperties": true,
      "description": "机会能带来什么（≠ 它是什么）：'没工资'不等于'没价值'"
    },
    "readiness": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "ready_now",
            "minor_preparation",
            "short_preparation",
            "major_preparation",
            "blocked",
            "unknown",
            null
          ]
        },
        "estimated_preparation": {
          "type": [
            "string",
            "null"
          ]
        },
        "ready_items": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "missing_items": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "blockers": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "description": "准备度（离真正开始还有多远）；不是录取概率，禁止输出录取率"
    },
    "effort": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "estimated_hours": {
          "type": [
            "number",
            "null"
          ]
        },
        "weekly_commitment": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration": {
          "type": [
            "string",
            "null"
          ]
        },
        "preparation_complexity": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "准备复杂度"
        }
      },
      "additionalProperties": true
    },
    "time_to_value": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "immediate",
        "weeks",
        "months",
        "long_term",
        "unknown",
        null
      ]
    },
    "schedule_flexibility": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "high",
        "medium",
        "low",
        "unknown",
        null
      ]
    },
    "career_capital": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "skill_capital": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "skill_capital"
        },
        "portfolio_capital": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "portfolio_capital"
        },
        "network_capital": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "network_capital"
        },
        "reputation_capital": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "reputation_capital"
        },
        "credential_capital": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "credential_capital"
        },
        "domain_capital": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "domain_capital"
        },
        "management_capital": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "management_capital"
        },
        "research_capital": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
            "unknown",
            null
          ],
          "description": "research_capital"
        }
      },
      "additionalProperties": true,
      "description": "对已工作的人：积累哪种职业资本"
    },
    "future_optionality": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "level": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "high",
            "medium",
            "low",
